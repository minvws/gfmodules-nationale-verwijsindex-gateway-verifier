[app]
# Loglevel can be one of: debug, info, warning, error, critical
loglevel=debug

[logging]
# Log type can be one of: nvi or prs, depending on which system is being used.
# application_log_type=nvi
# All keys are optional. When syslog_path is omitted, logs only go to stdout.
# Single syslog channel in host:port format (UDP). All streams (app, siem,
# public_inspect, debug) are sent here; each JSON record carries a stream_id
# field so the log server can tell them apart.
# syslog_path = syslog:5514
# Identifies this application in the JSON records (application_id field),
# so the log server can tell apart applications sharing the channel.
application_id = gateway-verifier
# Emit an access record per request.
access_logs = True
# Include exception/stack traces in JSON logs.
include_traces = False
# Which streams reach stdout as readable text: app, siem, debug (comma-separated).
# Empty leaves stdout silent.
console_streams = app,siem
# Log an error when a request arrives without an X-GF-Correlation-ID header
correlation_id_expected = False

[oin]
# URL of the Oauth service that issued the access token, used for validating the access token
issuer=https://oauth-service
# Comma separated list of audiences to use for validating the access token
audience=nvi,foo,bar
# URL of the JWKS endpoint to fetch the public keys for validating the access token
jwks_url=http://localhost:8532/oauth/jwks.json
# Optional mTLS certificate for connecting to the issuer
mtls_cert=
# Optional mTLS key for connecting to the issuer
mtls_key=
# Verify the issuer certificate using the system CA store. Set to False to
# disable verification or provide a CA bundle path.
verify_ca=True

[telemetry]
# Telemetry is enabled or not
enabled = False
# Endpoint to GRPC server for telemetry
endpoint = http://tracing:4317
# Service name to use
service_name = Gateway Verifier
# Tracer name to use
tracer_name = zmodules.service.gateway_verifier

[stats]
# Statsd is enabled or not
enabled = False
# Host for statsd server
host = 127.0.0.1
# Port for statsd server
port = 8125
# Module name for statsd
module_name = gateway-verifier


[uvicorn]
# If true, the api docs will be enabled
swagger_enabled = True
# Endpoint for swagger api docs
docs_url = /docs
# Endpoint for redoc api docs
redoc_url = /redocs
# Host for the uvicorn server
host = 0.0.0.0
# Port for the uvicorn server
port = 8503
# Live reload for uvicorn server
reload = True
# Delay before reload (in seconds)
reload_delay = 1

# SSL configuration
use_ssl = False
ssl_base_dir = secrets/ssl
ssl_cert_file = server.cert
ssl_key_file = server.key


[kong_proxy]
# Enable the /proxy for testing without kong infrastructure
enabled = True
# Url to proxy to. Could be a local NVI or PRS backend, or something like https://httpbin.org/headers
url =
# Forward a client-supplied X-GF-Correlation-ID to the backend instead of stripping
# it with the other x-gf-* headers, so one request can be traced across services.
allow_client_correlation_id = False
